[Unit]
Description=Prove Sal's sandbox: no devices, home files, LAN or Tailscale; the internet works

[Service]
Type=oneshot
User=sal
Group=sal
WorkingDirectory=/srv/sal/code
Environment=HOME=/srv/sal/data
ExecStart=/srv/sal/venv/bin/python -I /srv/sal/code/sandbox-check.py /srv/sal/code/check-targets.txt
