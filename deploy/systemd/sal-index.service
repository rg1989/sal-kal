[Unit]
Description=Index downloaded supermarket price files for Sal

[Service]
Type=oneshot
User=sal
Group=sal
WorkingDirectory=/srv/sal/code
Environment=HOME=/srv/sal/data BASKET_DB=/srv/sal/data/basket.db DUMPS_PATH=/srv/sal/data/dumps PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/sal/venv/bin/python -m app.indexer
# then place new stores on the map (OpenStreetMap, 1 lookup/s, cached)
ExecStart=/srv/sal/venv/bin/python -m app.geo
# then recompute the deals shelves (real savings vs typical prices)
ExecStart=/srv/sal/venv/bin/python -m app.deals
TimeoutStartSec=3h
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# a good neighbour on a shared machine
Nice=10
CPUWeight=50
IOWeight=50
MemoryMax=8G
