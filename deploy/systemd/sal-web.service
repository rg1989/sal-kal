[Unit]
Description=Sal web app (sandboxed, on /run/sal/web.sock)
Requires=sal-web.socket
After=sal-web.socket network-online.target
Wants=network-online.target

[Service]
User=sal
Group=sal
WorkingDirectory=/srv/sal/code
Environment=HOME=/srv/sal/data BASKET_DB=/srv/sal/data/basket.db DUMPS_PATH=/srv/sal/data/dumps PYTHONDONTWRITEBYTECODE=1
# fd 3 is the Unix socket systemd passes in from sal-web.socket
ExecStart=/srv/sal/venv/bin/uvicorn app.server:app --fd 3
Restart=on-failure
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
Also=sal-web.socket
