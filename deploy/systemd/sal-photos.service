[Unit]
Description=Fetch store catalogue photos for Sal

[Service]
Type=oneshot
User=sal
Group=sal
WorkingDirectory=/srv/sal/code
Environment=HOME=/srv/sal/data BASKET_DB=/srv/sal/data/basket.db PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/sal/venv/bin/python -m app.images
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
Nice=10
CPUWeight=20
MemoryMax=2G
