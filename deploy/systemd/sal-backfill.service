[Unit]
Description=Fill Sal's price history from the OpenIsraeliSupermarkets archive, one day a run (app.backfill auto)

[Service]
Type=oneshot
User=sal
Group=sal
WorkingDirectory=/srv/sal/code
Environment=HOME=/srv/sal/data BASKET_DB=/srv/sal/data/basket.db BACKFILL_CACHE_MB=700 PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/sal/venv/bin/python -u -m app.backfill auto
# a run is ~1 h; the 2h limit killed a 4-day run just before it applied (2026-11-06): generous, a stuck run still ends
TimeoutStartSec=5h
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# the last in line on a shared machine: nice 19 (the site and the indexer always come first), idle disk time,
# two processes at most (a day's build + the next day's download beside it). Memory: the build maps its stage and
# reads its days in memory; at 3G (page cache counts) it re-read ~100 GB from disk and took 25 min a day, so 5G (the
# server has 12 GB; sal-web is capped at 3G)
Nice=19
IOSchedulingClass=idle
CPUQuota=200%
MemoryHigh=4500M
MemoryMax=5G
